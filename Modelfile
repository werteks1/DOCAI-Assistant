# Modelfile для сборки высокоточной OCR-модели распознавания рукописных документов
# Имя модели при создании: docai-qwen25
#
# ВАЖНО: Системный промпт НЕ вшивается в модель — он передаётся динамически
# через extractor.py при каждом запросе. Это позволяет обновлять инструкции
# без пересборки модели через `ollama create`.

# Базовая мультимодальная модель (Vision)
FROM qwen2.5-vl:7b

# Параметры генерации для строгого детерминированного распознавания
# temperature=0.0 → greedy decoding (top_k/top_p не нужны)
PARAMETER temperature 0.0
PARAMETER num_ctx 16384
PARAMETER num_predict 4096
PARAMETER repeat_penalty 1.1
